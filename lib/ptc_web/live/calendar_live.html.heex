<%= if @view_mode == :list do %>
  <!-- List View -->
  <div>
    <%= if @time_period in [:all, :upcoming] do %>
      <div class="flex items-center justify-between mb-6">
        <h2 class={[
          "text-base",
          @theme == "dark" && "text-calendar-text-dark" || "text-slate-900"
        ]}>Upcoming Events</h2>
        <.link navigate={~p"/events"} class="text-sm text-blue-600 hover:text-blue-700">
          <.button>Manage Events</.button>
        </.link>
      </div>

      <div class="grid grid-cols-3 gap-6 mb-12">
        <%= for event <- @upcoming_events do %>
          <div class={[
            "rounded-xl shadow-sm overflow-hidden flex flex-col",
            @theme == "dark" && "bg-calendar-bg-dark border border-calendar-border-dark" || "bg-white"
          ]}>
            <div class={[
              "h-48 relative",
              @theme == "dark" && "bg-calendar-border-dark" || "bg-slate-200"
            ]}>
              <div class="absolute top-5 left-5 bg-blue-50 px-3 h-7 rounded-full flex items-center gap-1">
                <.icon name="hero-tag" class="w-3 h-3 text-blue-600" />
                <span class="text-sm text-blue-600">
                  <%= if event.tags != [] and event.tags != nil,
                    do: List.first(event.tags),
                    else: "Event" %>
                </span>
              </div>
            </div>

            <div class="p-5 flex flex-col flex-1">
              <h3 class={[
                "text-base font-normal mb-3",
                @theme == "dark" && "text-calendar-text-dark" || "text-slate-900"
              ]}>
                <%= event.name %>
              </h3>

              <p class={[
                "text-base mb-6 line-clamp-2 flex-1",
                @theme == "dark" && "text-calendar-muted-dark" || "text-slate-600"
              ]}>
                <%= event.observation || "Join us for an exciting event." %>
              </p>

              <div class="flex flex-col gap-2 mb-5">
                <%= if event.start_date do %>
                  <div class={[
                    "flex items-center gap-2 text-sm",
                    @theme == "dark" && "text-calendar-muted-dark" || "text-slate-600"
                  ]}>
                    <.icon name="hero-calendar" class="w-4 h-4" />
                    <span>
                      <%= Calendar.strftime(event.start_date, "%a, %b %-d, %Y") %>
                    </span>
                  </div>
                <% end %>

                <%= if event.location do %>
                  <div class={[
                    "flex items-center gap-2 text-sm",
                    @theme == "dark" && "text-calendar-muted-dark" || "text-slate-600"
                  ]}>
                    <.icon name="hero-map-pin" class="w-4 h-4" />
                    <span><%= event.location %></span>
                  </div>
                <% end %>
              </div>

              <.link
                navigate={~p"/events/#{event}/edit"}
                class="h-10 bg-blue-600 text-white rounded-lg flex items-center justify-center text-base hover:bg-blue-700 transition-colors"
              >
                View Details
              </.link>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= if @time_period in [:all, :past] and @past_events != [] do %>
      <div class="mb-6">
        <h2 class={[
          "text-base",
          @theme == "dark" && "text-calendar-text-dark" || "text-slate-900"
        ]}>Past Events</h2>
      </div>

      <div class="grid grid-cols-3 gap-6">
        <%= for event <- @past_events do %>
          <div class={[
            "rounded-xl shadow-sm overflow-hidden flex flex-col opacity-75",
            @theme == "dark" && "bg-calendar-bg-dark border border-calendar-border-dark" || "bg-white"
          ]}>
            <div class={[
              "h-48 relative",
              @theme == "dark" && "bg-calendar-border-dark" || "bg-slate-200"
            ]}>
              <div class={[
                "absolute top-3 right-3 px-3 h-8 rounded-full flex items-center",
                @theme == "dark" && "bg-calendar-text-dark/80 text-calendar-bg-dark" || "bg-slate-800/80 text-white"
              ]}>
                <span class="text-base">Past Event</span>
              </div>
              <div class="absolute top-5 left-5 bg-blue-50 px-3 h-7 rounded-full flex items-center gap-1">
                <.icon name="hero-tag" class="w-3 h-3 text-blue-600" />
                <span class="text-sm text-blue-600">
                  <%= if event.tags != [] and event.tags != nil,
                    do: List.first(event.tags),
                    else: "Event" %>
                </span>
              </div>
            </div>

            <div class="p-5 flex flex-col">
              <h3 class={[
                "text-base font-normal mb-3",
                @theme == "dark" && "text-calendar-text-dark" || "text-slate-900"
              ]}>
                <%= event.name %>
              </h3>

              <p class={[
                "text-base mb-6 line-clamp-2",
                @theme == "dark" && "text-calendar-muted-dark" || "text-slate-600"
              ]}>
                <%= event.observation || "This event has concluded." %>
              </p>

              <div class="flex flex-col gap-2">
                <%= if event.start_date do %>
                  <div class={[
                    "flex items-center gap-2 text-sm",
                    @theme == "dark" && "text-calendar-muted-dark" || "text-slate-600"
                  ]}>
                    <.icon name="hero-calendar" class="w-4 h-4" />
                    <span>
                      <%= Calendar.strftime(event.start_date, "%a, %b %-d, %Y") %>
                    </span>
                  </div>
                <% end %>

                <%= if event.location do %>
                  <div class={[
                    "flex items-center gap-2 text-sm",
                    @theme == "dark" && "text-calendar-muted-dark" || "text-slate-600"
                  ]}>
                    <.icon name="hero-map-pin" class="w-4 h-4" />
                    <span><%= event.location %></span>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <!-- Calendar View -->
  <div>
    <div class={[
      "border rounded-xl p-8",
      @theme == "dark" && "bg-calendar-bg-dark border-calendar-border-dark" || "bg-white border-slate-200"
    ]}>
      <!-- Calendar Header -->
      <div class="flex items-center justify-between mb-6">
        <div class={[
          "flex items-center gap-2 text-base font-normal",
          @theme == "dark" && "text-calendar-text-dark" || "text-slate-900"
        ]}>
          <.icon name="hero-calendar" class="w-5 h-5 text-blue-600" />
          <span>{month_name(@month)} {Integer.to_string(@year)}</span>
        </div>

        <div class="flex items-center gap-2">
          <button
            phx-click="prev_month"
            class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-slate-100 transition-colors"
          >
            <.icon name="hero-chevron-left" class="w-5 h-5 text-slate-600" />
          </button>

          <button
            phx-click="next_month"
            class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-slate-100 transition-colors"
          >
            <.icon name="hero-chevron-right" class="w-5 h-5 text-slate-600" />
          </button>
        </div>
      </div>

      <!-- Day Names -->
      <div class={[
        "grid grid-cols-7 gap-px border rounded-t-lg overflow-hidden",
        @theme == "dark" && "bg-calendar-border-dark border-calendar-border-dark" || "bg-slate-200 border-slate-200"
      ]}>
        <%= for day <- ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"] do %>
          <div class={[
            "py-3 text-center text-sm font-medium",
            @theme == "dark" && "bg-calendar-bg-dark text-calendar-text-dark" || "bg-white text-slate-700"
          ]}>
            {day}
          </div>
        <% end %>
      </div>

      <!-- Calendar Grid -->
      <div class={[
        "grid grid-cols-7 gap-px border-x border-b rounded-b-lg overflow-hidden",
        @theme == "dark" && "bg-calendar-border-dark border-calendar-border-dark" || "bg-slate-200 border-slate-200"
      ]}>
        <%= for day <- calendar_days(@year, @month) do %>
          <%= if day do %>
            <div class={[
              "min-h-[100px] p-2 relative",
              @theme == "dark" && if(day.month != @month, do: "bg-calendar-border-dark", else: "bg-calendar-bg-dark"),
              @theme == "light" && if(day.month != @month, do: "bg-slate-50", else: "bg-white")
            ]}>
              <div class={[
                "text-sm font-normal mb-1",
                Date.compare(day, @current_date) == :eq && "flex items-center justify-center w-6 h-6 bg-blue-600 text-white rounded",
                Date.compare(day, @current_date) != :eq && day.month == @month && if(@theme == "dark", do: "text-calendar-text-dark", else: "text-slate-700"),
                day.month != @month && if(@theme == "dark", do: "text-calendar-muted-dark", else: "text-slate-400")
              ]}>
                {day.day}
              </div>

              <!-- Events in this date -->
              <div class="space-y-1">
                <%= if Map.has_key?(@events_by_date, Date.to_string(day)) do %>
                  <%= for event <- Enum.take(Map.get(@events_by_date, Date.to_string(day)), 2) do %>
                    <button
                      phx-click="select_event"
                      phx-value-id={event.id}
                      class="w-full text-left px-2 py-1 bg-blue-100 text-blue-700 text-xs rounded hover:bg-blue-200 transition-colors truncate"
                    >
                      {event.name}
                    </button>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% else %>
            <div class={[
              "min-h-[100px]",
              @theme == "dark" && "bg-calendar-bg-dark" || "bg-white"
            ]}></div>
          <% end %>
        <% end %>
      </div>

      <!-- Legend -->
      <div class="flex items-center gap-6 mt-6">
        <div class="flex items-center gap-2">
          <div class="w-4 h-4 bg-blue-600 rounded"></div>
          <span class={[
            "text-sm",
            @theme == "dark" && "text-calendar-muted-dark" || "text-slate-600"
          ]}>Today</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-4 h-4 bg-blue-100 rounded"></div>
          <span class={[
            "text-sm",
            @theme == "dark" && "text-calendar-muted-dark" || "text-slate-600"
          ]}>Event</span>
        </div>
      </div>
    </div>
  </div>
<% end %>
